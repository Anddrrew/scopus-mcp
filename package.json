{
  "name": "scopus-mcp",
  "mcpName": "io.github.Anddrrew/scopus-mcp",
  "version": "0.4.0",
  "description": "Scopus API access over the Model Context Protocol (stdio).",
  "type": "module",
  "license": "MIT",
  "author": "Andrii Baran (https://github.com/Anddrrew)",
  "bin": {
    "scopus-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run typecheck && tsx scripts/build.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "husky",
    "prepack": "npm run build",
    "test:run": "node --import tsx --test test/*.test.ts test/schemas/*.test.ts test/scopus/*.test.ts test/tools/*.test.ts"
  },
  "keywords": [
    "scopus",
    "mcp",
    "model-context-protocol",
    "elsevier"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anddrrew/scopus-mcp.git"
  }
}
